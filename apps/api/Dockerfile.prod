FROM python:3.11-slim

WORKDIR /workspace

# Pin ffmpeg to major version 7 (Debian's ffmpeg package epoch tracks its
# major version, e.g. "7:7.1.5-0+deb13u1") — floats on patch/security
# updates within v7, but fails the build instead of silently jumping to a
# new major version if the base image's Debian release ever moves on.
RUN apt-get update && \
    FFMPEG_PKG="$(apt-cache madison ffmpeg | awk '{print $3}' | grep -E '^7:' | head -n1)" && \
    test -n "$FFMPEG_PKG" && \
    apt-get install -y \
    ffmpeg=$FFMPEG_PKG \
    imagemagick \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install API dependencies
COPY apps/api/requirements.txt /workspace/apps/api/requirements.txt
RUN pip install --no-cache-dir -r /workspace/apps/api/requirements.txt
RUN pip install --no-cache-dir gunicorn

# Copy transcoder package and API
COPY packages/transcoder /workspace/packages/transcoder
COPY apps/api /workspace/apps/api

# Create non-root user with a real, owned home dir — gunicorn's control
# server writes there, and --no-create-home left it permission-denied.
RUN adduser --disabled-password appuser

WORKDIR /workspace

# No HEALTHCHECK here: this image is shared by the API *and* the Celery
# worker/beat/email_worker, which don't serve HTTP — a baked-in `curl :8000/health`
# marks every worker perpetually "unhealthy". The API's healthcheck lives on the
# `api` service in docker-compose.prod.yml instead.

USER appuser

EXPOSE 8000

CMD ["gunicorn", "apps.api.main:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--graceful-timeout", "30"]
